[Unit]
Description=mfl-leads: Maps, até 20 bairros por noite
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/Projetos/mfl-leads
ExecStart=%h/.local/bin/uv run --frozen mfl maps-noturno
Nice=10
IOSchedulingClass=idle
# Um bairro iniciado antes das 04h pode levar 60 min, mais ingestão e score.
TimeoutStartSec=5h30min
